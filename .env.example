# The application works without a .env file. Copy this file only when you need
# a different port, larger uploads, persistent sessions, Azure SSO, or cross-origin API access.

# APP_PORT=5000

# Optional site favicon URL, fetched directly by the browser.
# FAVICON_URL=https://example.com/favicon.ico

# Sizes are in GB (1 GB = 1,000,000,000 bytes); decimals such as 2.5 are supported.
# Without overrides, defaults are 3 GB uploads and 1 GB extracted per archive.
MAX_CONTENT_LENGTH_GB=10
MAX_ARCHIVE_EXTRACTED_SIZE_GB=10
# Maximum number of entries per archive (default: 10,000).
MAX_ARCHIVE_ENTRIES=10000

# Optional LiquidFiles delivery. Requires SSO and a dedicated sending account's API key.
# Messages are sent by the API account (e.g. dicom-anonymizer@inspiremd.com), not the SSO user.
# LIQUIDFILES_URL=https://files.example.com
# LIQUIDFILES_API_KEY=
# LIQUIDFILES_TIMEOUT_SECONDS=1800
# LIQUIDFILES_EXPIRY_DAYS=7

# Keep this value stable across restarts when using SSO.
# Generate one with: openssl rand -hex 32
# SECRET_KEY=

# Optional Microsoft Entra ID (Azure AD) SSO.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=

# Optional comma-separated origins allowed to call /api routes.
# CORS_ALLOWED_ORIGINS=
